tools/_tmp_html_*.html

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.venv/
venv/

# 个人工作笔记
.workbuddy/

# 系统与编辑器
.DS_Store
Thumbs.db
.idea/
